# Salin ke .env lalu isi. JANGAN commit .env.
PORT=3000
NODE_ENV=production

# Resend (https://resend.com): API key + domain winaya.id harus sudah terverifikasi
RESEND_API_KEY=
MAIL_FROM=Farah dari Winaya <info@winaya.id>

# Email tim Winaya yang menerima notifikasi tiap ada PDF terkirim (bawaan: info@winaya.id).
# Kosongkan nilainya (OWNER_EMAIL=) untuk mematikan notifikasi.
OWNER_EMAIL=info@winaya.id

# Dipakai untuk membentuk tautan berhenti berlangganan di email
PUBLIC_BASE_URL=https://winaya.id

# Origin yang boleh memanggil endpoint (pisahkan koma)
ALLOWED_ORIGINS=https://winaya.id,https://www.winaya.id

# Lokasi database email (di dalam container; harus berada di volume /data)
DB_PATH=/data/subscribers.db

# Sisa slot program Founding Customer (isi manual, samakan dengan "Slot tersisa" di index.html).
# Isi 0 saat slot habis: blok promo di email PDF otomatis hilang.
FOUNDING_SLOTS_LEFT=3
